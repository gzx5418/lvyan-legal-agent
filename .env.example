# 律言法律智能体 Docker 部署配置示例
# ====================================
# 用法：cp .env.example .env  →  修改下方各项  →  docker compose up -d
#
# 所有带默认值（compose 中 ${VAR:-default}）的项可留空使用默认值；
# 标记【必改】的项生产部署前必须替换为强随机值。

# ---------------------------------------------------------------------------
# PostgreSQL（checkpointer + 业务元数据）
# ---------------------------------------------------------------------------
POSTGRES_USER=lvyan
# 【必改】生产部署必须替换为强密码
POSTGRES_PASSWORD=lvyan
POSTGRES_DB=lvyan
# 宿主机映射端口（容器内固定 5432）；不需要对外暴露时设为 127.0.0.1:5432
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# OpenSearch（条文检索）
# ---------------------------------------------------------------------------
# W7：URL 可配置，启用 TLS 时改为 https://opensearch:9200
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_PORT=9200
OPENSEARCH_BIND_HOST=127.0.0.1
# 本地开发禁用安全插件；生产设 false 启用 TLS + 认证
OPENSEARCH_DISABLE_SECURITY=true
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ---------------------------------------------------------------------------
# MinIO（对象存储，当前应用代码保留位未实际接入）
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=lvyan
# 【必改】生产部署必须替换
MINIO_ROOT_PASSWORD=lvyan_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 对象存储端点（应用代码保留位，未实际接入）
OBJECT_STORAGE_ENDPOINT=minio:9000

# ---------------------------------------------------------------------------
# 模型网关（LLM 调用）
# ---------------------------------------------------------------------------
# 【必填】留空则 LLM 节点全部不可用，仅规则路径可走通
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=
# 模型名（按网关支持的模型调整，以下为 SiliconFlow / HuggingFace 默认值）
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---------------------------------------------------------------------------
# 应用本体
# ---------------------------------------------------------------------------
APP_PORT=8000
# 示例默认用于本地开发。生产部署改为 production，并同时启用认证、
# 将 AUTH_MODE 设置为 jwt 或 trusted_proxy。
RUNTIME_MODE=development
PERSISTENCE_REQUIRED=true
CHECKPOINTER_BACKEND=postgres
# W6：可信反向代理 IP 白名单（X-Forwarded-For 接受范围）
# 默认仅信任容器内网；部署在 nginx/cloudflare 后方时设为代理 IP 或 "*"
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# 认证：仅本地开发默认关闭；生产部署必须开启并配置可信认证模式
AUTH_ENABLED=false
AUTH_MODE=auto
JWT_VERIFY_IN_PROCESS=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_ALGORITHMS=RS256

# CORS：启用凭据时禁止 *，必须明确来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 可观测性（可选，留空则关闭 trace 上报）
# ---------------------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 仅当 docker compose --profile full up 启动 langfuse 服务时有效
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# 【必改】启用 langfuse 时必须替换
LANGFUSE_NEXTAUTH_SECRET=lvyan-dev-nextauth-secret-change-me
LANGFUSE_SALT=lvyan-dev-salt-change-me

# ---------------------------------------------------------------------------
# 官方法律全文库（git submodule，采集自 flk.npc.gov.cn）
# ---------------------------------------------------------------------------
# 留空时按优先级自动解析：
#   1) 此处显式指定的路径
#   2) AGENT/external/lvyan-lawtext/content（git submodule，默认）
# submodule 未检出时，应用降级到精编知识库（不影响启动，但检索召回会受限）。
#
# Docker 部署：镜像构建期已 COPY submodule 内容，无需设置此项；
# 如需挂载外部更新的法条库，可挂卷到此路径并覆盖。
LAWTEXT_DIR=

# ---------------------------------------------------------------------------
# 业务参数（有合理默认值，按需覆盖）
# ---------------------------------------------------------------------------
# 注意：以下重试 / 资源上限默认值与 src/lvyan/config.py 的代码默认值保持一致，
# 取较保守的生产安全值（最坏 LLM 调用放大可控、内存与并发受限）。
# 高吞吐场景（独立强机器、需处理大附件多并发）请改用 .env.high-capacity.example。
MAX_UPLOAD_BYTES=10485760
HITL_ENABLED=true
CANCEL_POLL_INTERVAL_SECONDS=2
# 附件 / 文档转换资源上限（防止滥用与 OOM）
MAX_ATTACHMENT_COUNT=10
MAX_EXTRACTED_CHARS_PER_FILE=200000
MAX_TOTAL_ATTACHMENT_CHARS=400000
MAX_CONCURRENT_CONVERSIONS=2
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=60
ZIP_UNCOMPRESSED_BYTES_LIMIT=104857600
# 检索 / 推理上限（防止失控循环；与 config.py 代码默认值一致）
MAX_RETRIEVAL_ITERATIONS=1
MAX_LEGAL_REASONER_ITERATIONS=1
MAX_COST_BUDGET_USD=2.0

# ---------------------------------------------------------------------------
# 法律语料库就绪策略（P0-4）
# ---------------------------------------------------------------------------
# 生产环境是否强制要求完整官方法律库（external/lvyan-lawtext）可用。
# true（生产推荐）：法律库缺失时 /readyz 返回 not-ready（503），避免在
#   仅精编知识库子集下被误判为「就绪」承接生产流量。
# false：法律库缺失时仍 ready（降级到 curated 精编知识库）。
# 开发环境默认不设置（按 false 处理）；Docker 生产镜像默认 true。
REQUIRE_OFFICIAL_LAW_DB=true

# ---------------------------------------------------------------------------
# 速率限制（P1-4）
# ---------------------------------------------------------------------------
# 启用/禁用速率限制；默认开启
RATE_LIMIT_ENABLED=true
# 每分钟最大请求数（按 IP；仅限 POST/PUT/PATCH/DELETE 请求）
RATE_LIMIT_RUN_RPM=10
RATE_LIMIT_UPLOAD_RPM=20
RATE_LIMIT_DEFAULT_RPM=60

# ---------------------------------------------------------------------------
# 案件材料加密（case vault）
# ---------------------------------------------------------------------------
# AES-256-GCM 对称加密密钥（64 位 hex 字符 = 32 字节），例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 留空时降级为 base64 编码（仅开发环境可接受，生产必须配置）。
CASE_VAULT_KEY=
