# 律言法律智能体 Docker 部署配置示例
# ====================================
# 用法：cp .env.example .env  →  修改下方各项  →  docker compose up -d
#
# 所有带默认值（compose 中 ${VAR:-default}）的项可留空使用默认值；
# 标记【必改】的项生产部署前必须替换为强随机值。

# ---------------------------------------------------------------------------
# PostgreSQL（checkpointer + 业务元数据）
# ---------------------------------------------------------------------------
POSTGRES_USER=lvyan
# 【必改】生产部署必须替换为强密码
POSTGRES_PASSWORD=lvyan
POSTGRES_DB=lvyan
# 宿主机映射端口（容器内固定 5432）；不需要对外暴露时设为 127.0.0.1:5432
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# OpenSearch（条文检索）
# ---------------------------------------------------------------------------
# W7：URL 可配置，启用 TLS 时改为 https://opensearch:9200
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_PORT=9200
# 本地开发禁用安全插件；生产设 false 启用 TLS + 认证
OPENSEARCH_DISABLE_SECURITY=true
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ---------------------------------------------------------------------------
# MinIO（对象存储，当前应用代码保留位未实际接入）
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=lvyan
# 【必改】生产部署必须替换
MINIO_ROOT_PASSWORD=lvyan_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 对象存储端点（应用代码保留位，未实际接入）
OBJECT_STORAGE_ENDPOINT=minio:9000

# ---------------------------------------------------------------------------
# 模型网关（LLM 调用）
# ---------------------------------------------------------------------------
# 【必填】留空则 LLM 节点全部不可用，仅规则路径可走通
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=
# 模型名（按网关支持的模型调整，以下为 SiliconFlow / HuggingFace 默认值）
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---------------------------------------------------------------------------
# 应用本体
# ---------------------------------------------------------------------------
APP_PORT=8000
# 生产模式：禁止任何静默降级（MemorySaver / 无认证 / 等）
RUNTIME_MODE=production
PERSISTENCE_REQUIRED=true
CHECKPOINTER_BACKEND=postgres
# W6：可信反向代理 IP 白名单（X-Forwarded-For 接受范围）
# 默认仅信任容器内网；部署在 nginx/cloudflare 后方时设为代理 IP 或 "*"
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# 认证：默认关闭方便首次部署；启用 JWT 时设 true 并配置下方 JWKS
# ⚠️ 生产部署强烈建议开启认证，否则 API 完全无防护
AUTH_ENABLED=false
AUTH_MODE=auto
JWT_VERIFY_IN_PROCESS=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_ALGORITHMS=RS256

# CORS：启用凭据时禁止 *，必须明确来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 可观测性（可选，留空则关闭 trace 上报）
# ---------------------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 仅当 docker compose --profile full up 启动 langfuse 服务时有效
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# 【必改】启用 langfuse 时必须替换
LANGFUSE_NEXTAUTH_SECRET=lvyan-dev-nextauth-secret-change-me
LANGFUSE_SALT=lvyan-dev-salt-change-me

# ---------------------------------------------------------------------------
# 官方法律全文库（git submodule，采集自 flk.npc.gov.cn）
# ---------------------------------------------------------------------------
# 留空时按优先级自动解析：
#   1) 此处显式指定的路径
#   2) AGENT/external/lvyan-lawtext/content（git submodule，默认）
# submodule 未检出时，应用降级到精编知识库（不影响启动，但检索召回会受限）。
#
# Docker 部署：镜像构建期已 COPY submodule 内容，无需设置此项；
# 如需挂载外部更新的法条库，可挂卷到此路径并覆盖。
LAWTEXT_DIR=

# ---------------------------------------------------------------------------
# 业务参数（有合理默认值，按需覆盖）
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
HITL_ENABLED=true
CANCEL_POLL_INTERVAL_SECONDS=2
# 附件 / 文档转换资源上限（防止滥用与 OOM）
MAX_ATTACHMENT_COUNT=20
MAX_EXTRACTED_CHARS_PER_FILE=200000
MAX_TOTAL_ATTACHMENT_CHARS=500000
MAX_CONCURRENT_CONVERSIONS=4
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=120
ZIP_UNCOMPRESSED_BYTES_LIMIT=104857600
# 检索 / 推理上限（防止失控循环）
MAX_RETRIEVAL_ITERATIONS=3
MAX_LEGAL_REASONER_ITERATIONS=3
MAX_COST_BUDGET_USD=5.0
