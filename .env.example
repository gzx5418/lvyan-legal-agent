# 律言法律智能体 Docker 部署配置示例
# ====================================
# 用法：cp .env.example .env  →  修改下方各项  →  docker compose up -d
#
# 所有带默认值（compose 中 ${VAR:-default}）的项可留空使用默认值；
# 标记【必改】的项生产部署前必须替换为强随机值。

# ---------------------------------------------------------------------------
# PostgreSQL（checkpointer + 业务元数据）
# ---------------------------------------------------------------------------
POSTGRES_USER=lvyan
# 【必改】生产部署必须替换为强密码
POSTGRES_PASSWORD=lvyan
POSTGRES_DB=lvyan
# 宿主机映射端口（容器内固定 5432）；不需要对外暴露时设为 127.0.0.1:5432
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# OpenSearch（条文检索）
# ---------------------------------------------------------------------------
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_PORT=9200
# 本地开发禁用安全插件；生产设 false 启用 TLS + 认证
OPENSEARCH_DISABLE_SECURITY=true
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ---------------------------------------------------------------------------
# MinIO（对象存储，当前应用代码保留位未实际接入）
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=lvyan
# 【必改】生产部署必须替换
MINIO_ROOT_PASSWORD=lvyan_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# 模型网关（LLM 调用）
# ---------------------------------------------------------------------------
# 【必填】留空则 LLM 节点全部不可用，仅规则路径可走通
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# 应用本体
# ---------------------------------------------------------------------------
APP_PORT=8000
# 生产模式：禁止任何静默降级（MemorySaver / 无认证 / 等）
RUNTIME_MODE=production
PERSISTENCE_REQUIRED=true
CHECKPOINTER_BACKEND=postgres

# 认证：默认关闭方便首次部署；启用 JWT 时设 true 并配置下方 JWKS
AUTH_ENABLED=false
AUTH_MODE=auto
JWT_VERIFY_IN_PROCESS=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_ALGORITHMS=RS256

# CORS：启用凭据时禁止 *，必须明确来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 可观测性（可选，留空则关闭 trace 上报）
# ---------------------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 仅当 docker compose --profile full up 启动 langfuse 服务时有效
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# 【必改】启用 langfuse 时必须替换
LANGFUSE_NEXTAUTH_SECRET=lvyan-dev-nextauth-secret-change-me
LANGFUSE_SALT=lvyan-dev-salt-change-me

# ---------------------------------------------------------------------------
# 业务参数（有合理默认值，按需覆盖）
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
HITL_ENABLED=true
CANCEL_POLL_INTERVAL_SECONDS=2
