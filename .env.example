# 模型网关 - 硅基流动 (SiliconFlow)
# 注意：URL 不含 /v1 后缀，代码会自动拼接 /v1/chat/completions 等路径
MODEL_GATEWAY_URL=https://api.siliconflow.cn
MODEL_GATEWAY_API_KEY=sk-your-api-key-here

# 模型选择
# Chat: DeepSeek-V4-Flash (284B MoE, 1M 上下文, 旗舰级)
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Embedding: BAAI/bge-m3 (1024维, 中文 embedding 标杆)
EMBEDDING_MODEL=BAAI/bge-m3
# Reranker: BAAI/bge-reranker-v2-m3 (中文 reranker 标杆)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Vision: Qwen/Qwen3-VL-8B-Instruct (图片理解, 中文 OCR + 场景描述)
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---------------------------------------------------------------------------
# M3：API 认证（X-User-ID 网关模式 vs 进程内 JWT 验签）
# ---------------------------------------------------------------------------
# 默认 false：单租户本地开发零依赖，user_id 恒为 anonymous。
# 生产部署设为 true。
AUTH_ENABLED=false

# 进程内 JWT 验签开关（M3）：
# - false（默认）：本服务不信任 Bearer JWT；身份必须由可信 API Gateway /
#   OIDC Proxy 注入 X-User-ID 头。网关必须先剥离客户端传入的原始 X-User-ID，
#   再注入可信身份。服务不得在未经过网关的情况下直接暴露 8000 端口。
# - true：接受 Bearer JWT，验签（签名 + exp + nbf + iss + aud）通过后读取 sub。
#   需要正确配置 JWT_JWKS_URL / JWT_ISSUER / JWT_AUDIENCE。
JWT_VERIFY_IN_PROCESS=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
# 允许的签名算法，逗号分隔；默认 RS256。禁止允许 none。
JWT_ALGORITHMS=RS256
# 认证模式（三-1）：
#   jwt          —— 只接受验签 Bearer JWT（独立部署）
#   trusted_proxy —— 只接受可信网关注入的 X-User-ID（网关前置）
#   auto         —— X-User-ID 优先，其次 Bearer（仅本地开发）
AUTH_MODE=auto

# ---------------------------------------------------------------------------
# P0-1：部署模式与持久化强制（生产必须正确配置）
# ---------------------------------------------------------------------------
# development（默认）：允许 PostgresSaver / metadata store 不可用时静默降级到
#   MemorySaver / None，开箱即跑，但 run/HITL/checkpoint 不跨实例恢复。
# production：禁止任何静默降级；初始化失败直接让服务启动失败。
RUNTIME_MODE=development
# 即使在 development 也强制持久化（CI / 预发用）
PERSISTENCE_REQUIRED=false
# 期望的 checkpointer 后端：postgres / memory / auto
CHECKPOINTER_BACKEND=auto

# ---------------------------------------------------------------------------
# P1-2 / P1-4：运行时资源限制
# ---------------------------------------------------------------------------
CANCEL_POLL_INTERVAL_SECONDS=5
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS_PER_FILE=200000
MAX_TOTAL_ATTACHMENT_CHARS=400000
MAX_ATTACHMENT_COUNT=10
MAX_CONCURRENT_CONVERSIONS=2
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=60
ZIP_UNCOMPRESSED_BYTES_LIMIT=104857600
